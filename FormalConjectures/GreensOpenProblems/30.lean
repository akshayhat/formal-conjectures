import FormalConjectures.Util.ProblemImports

/-!
# Ben Green's Open Problem 30

*Reference:* https://people.maths.ox.ac.uk/greenbj/papers/open-problems.pdf#problem.30
-/

namespace Green30

/--
Given a finite set `A ⊆ ℤ` with small doubling
`|A - A| / |A| ≤ K`, find a large structured subset `A' ⊆ A`
with similarly small doubling.

Here "large" and "structured" are intentionally left informal,
following Green's original wording.
-/
@[category research open, AMS 5 11]
theorem green_30 :
  answer(sorry) := by
  sorry

end Green30
